{
  "name": "tsp-azure-service-bus",
  "version": "0.1.0",
  "type": "module",
  "description": "A TypeSpec library for the versioned Azure Service Bus AsyncAPI contract profile. No emitter, runtime, SDK, or provisioning.",
  "main": "dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "tspMain": "lib/main.tsp",
  "exports": {
    ".": {
      "typespec": "./lib/main.tsp",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "default": "./dist/src/testing.js"
    }
  },
  "files": [
    "dist",
    "lib",
    "schema",
    "README.md",
    "README.zh-TW.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "author": "Marvin Hsu <contact@marvinhsu.dev> (https://github.com/marvin-hsu)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marvin-hsu/tsp-asyncapi.git"
  },
  "bugs": {
    "url": "https://github.com/marvin-hsu/tsp-asyncapi/issues"
  },
  "homepage": "https://tsp-asyncapi.marvinhsu.dev/reference/service-bus",
  "keywords": [
    "typespec",
    "asyncapi",
    "azure",
    "service-bus",
    "contract",
    "library"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@typespec/versioning": "0.85.0",
    "ajv": "^8.20.0"
  },
  "peerDependencies": {
    "@typespec/compiler": "~1.15.0",
    "tsp-asyncapi-core": "workspace:^"
  },
  "scripts": {
    "clean": "rimraf ./dist ./temp",
    "prebuild": "pnpm run clean",
    "build": "tsc -b tsconfig.json",
    "api-extractor:local": "api-extractor run --local && api-extractor run --local -c api-extractor.types.json",
    "api-extractor:ci": "api-extractor run && api-extractor run -c api-extractor.types.json",
    "check:package": "rimraf -g \"./temp/*.tgz\" && pnpm pack --pack-destination temp && publint && attw --profile esm-only temp/tsp-azure-service-bus-[0-9]*.tgz"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.59.0",
    "@typespec/compiler": "1.15.0",
    "publint": "^0.3.23",
    "rimraf": "^6.1.3",
    "tsp-asyncapi": "workspace:*",
    "tsp-asyncapi-core": "workspace:^",
    "typescript": "^6.0.3"
  }
}
